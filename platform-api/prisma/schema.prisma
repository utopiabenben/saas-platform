// SaaS Platform V3.0 — Identity · Tenant · Catalog · Billing · Ledgers · Distribution
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────

enum AccountStatus {
  active
  frozen
  pending_deletion
  deleted
}

enum TenantStatus {
  trial
  active
  past_due
  suspended
  closed
}

enum MembershipStatus {
  active
  invited
  disabled
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum ApplicationStatus {
  draft
  active
  deprecated
}

enum TenantAppStatus {
  provisioning
  active
  suspended
  closed
}

enum BillingPeriod {
  monthly
  yearly
  one_time
  metered
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  grace_period
  suspended
  expired
  canceled
}

enum OrderType {
  SAAS_SUBSCRIPTION
  SAAS_ADDON
  BUSINESS_ORDER
  CHANNEL_PURCHASE
}

enum OrderStatus {
  pending
  paid
  refunded
  partially_refunded
  canceled
  failed
}

enum PaymentStatus {
  pending
  succeeded
  failed
  canceled
}

enum RefundStatus {
  pending
  succeeded
  failed
}

enum LedgerDirection {
  credit
  debit
}

enum PointsLedgerType {
  earn
  redeem
  expire
  adjust
  clawback
}

enum RewardType {
  virtual
  physical
}

enum FulfillStatus {
  pending
  granted
  shipped
  failed
  cancelled
}

enum CommissionStatus {
  pending
  eligible
  in_statement
  approved
  paid
  reversed
  clawback
}

enum StatementReviewStatus {
  draft
  pending_review
  approved
  paid
  rejected
}

enum PartnerStatus {
  pending
  active
  suspended
}

enum OutboxStatus {
  pending
  delivered
  failed
  dead
}

enum FeatureValueType {
  boolean
  limit
  metered
  tier
}

// ─── Identity ──────────────────────────────────────────

model Account {
  id          String        @id @default(cuid())
  displayName String?
  avatarUrl   String?
  status      AccountStatus @default(active)
  locale      String        @default("zh-CN")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  identities       AccountIdentity[]
  sessions         Session[]
  securityEvents   AccountSecurityEvent[]
  memberships      Membership[]
  invitationsSent  Invitation[]           @relation("InvitationInviter")
  auditLogs        AuditLog[]
  platformRoles    PlatformRoleBinding[]
}

model AccountIdentity {
  id            String    @id @default(cuid())
  accountId     String
  provider      String // password_email | password_phone | wechat | oidc
  identifier    String
  verifiedAt    DateTime?
  credentialRef String? // password hash or external subject
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([provider, identifier])
  @@index([accountId])
}

model Session {
  id               String    @id @default(cuid())
  accountId        String
  refreshTokenHash String
  device           String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([refreshTokenHash])
}

model AccountSecurityEvent {
  id        String   @id @default(cuid())
  accountId String
  type      String
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

model PlatformRoleBinding {
  id        String   @id @default(cuid())
  accountId String
  roleCode  String // platform_owner | platform_admin | ...
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, roleCode])
}

// ─── Tenant / Org / RBAC ───────────────────────────────

model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  status    TenantStatus @default(trial)
  timezone  String       @default("Asia/Shanghai")
  currency  String       @default("CNY")
  locale    String       @default("zh-CN")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  profile           TenantProfile?
  memberships       Membership[]
  invitations       Invitation[]
  workspaces        Workspace[]
  tenantApps        TenantApp[]
  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]
  subscriptions     Subscription[]
  billingOrders     BillingOrder[]
  pointsAccounts    PointsAccount[]
  pointsLedgers     PointsLedger[]
  pointsRules       PointsRule[]
  rewardCatalog     RewardCatalog[]
  redemptions       Redemption[]
  usageAccounts     UsageAccount[]
  usageEvents       UsageEvent[]
  entitlements      Entitlement[]
  wallets           Wallet[]
  affiliatePartners AffiliatePartner[]
  storefronts       PartnerStorefront[]
  attributions      Attribution[]
  orderRefs         OrderRef[]
  affiliateLedgers  AffiliateCommissionLedger[]
  affiliateSettlements AffiliateSettlement[]
  channelReferrals  TenantReferral[]
  auditLogs         AuditLog[]
  idempotencyKeys   IdempotencyKey[]
  outboxEvents      OutboxEvent[]
  inboxEvents       InboxEvent[]
  roles             Role[]
}

model TenantProfile {
  id              String  @id @default(cuid())
  tenantId        String  @unique
  industry        String?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  billingInfo     Json?
  brandDomain     String?
  logoUrl         String?
  channelSource   String?
  salesOwnerId    String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Workspace {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships WorkspaceMembership[]

  @@index([tenantId])
}

model Membership {
  id        String           @id @default(cuid())
  tenantId  String
  accountId String
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account     Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  roles       MembershipRole[]
  workspaces  WorkspaceMembership[]
  pointsAccount PointsAccount?
  affiliatePartner AffiliatePartner?

  @@unique([tenantId, accountId])
  @@index([accountId])
}

model WorkspaceMembership {
  id           String @id @default(cuid())
  workspaceId  String
  membershipId String

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, membershipId])
}

model Invitation {
  id          String           @id @default(cuid())
  tenantId    String
  email       String
  roleCodes   String[]
  status      InvitationStatus @default(pending)
  tokenHash   String
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy Account? @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([tenantId, email])
  @@index([tokenHash])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String? // null = system template
  code        String
  name        String
  scope       String   @default("tenant") // platform | tenant | application | channel
  applicationId String?
  createdAt   DateTime @default(now())

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, code])
  @@index([code])
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model MembershipRole {
  membershipId String
  roleId       String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}

// ─── Application Catalog ───────────────────────────────

model Application {
  id              String            @id @default(cuid())
  applicationKey  String            @unique
  name            String
  description     String?
  iconUrl         String?
  status          ApplicationStatus @default(active)
  selfServe       Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenantApps TenantApp[]
  plans      Plan[]
}

model TenantApp {
  id              String          @id @default(cuid())
  tenantId        String
  applicationId   String
  instanceKey     String
  status          TenantAppStatus @default(active)
  customDomain    String?
  appConfig       Json?
  clientId        String          @unique @default(cuid())
  secretHash      String?
  webhookUrl      String?
  webhookSecret   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application   Application    @relation(fields: [applicationId], references: [id])
  subscriptions Subscription[]
  orderRefs     OrderRef[]
  usageEvents   UsageEvent[]

  @@unique([tenantId, applicationId, instanceKey])
  @@index([tenantId])
}

model ApiKey {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  keyHash   String
  prefix    String
  scopes    String[]
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([prefix])
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  tenantId  String
  url       String
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId])
}

model WebhookDelivery {
  id         String       @id @default(cuid())
  endpointId String
  eventId    String
  status     OutboxStatus @default(pending)
  attempts   Int          @default(0)
  lastError  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, status])
}

// ─── Plans & Subscriptions (P1) ────────────────────────

model Plan {
  id            String        @id @default(cuid())
  applicationId String
  planCode      String
  name          String
  version       Int           @default(1)
  status        String        @default("active")
  billingPeriod BillingPeriod @default(monthly)
  price         Decimal       @db.Decimal(12, 2)
  currency      String        @default("CNY")
  trialDays     Int           @default(0)
  seatLimit     Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  application   Application    @relation(fields: [applicationId], references: [id])
  features      PlanFeature[]
  subscriptions Subscription[]

  @@unique([applicationId, planCode, version])
}

model Feature {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  valueType FeatureValueType @default(boolean)

  planFeatures PlanFeature[]
}

model PlanFeature {
  id         String  @id @default(cuid())
  planId     String
  featureId  String
  boolValue  Boolean?
  limitValue Int?
  meta       Json?

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([planId, featureId])
}

model Subscription {
  id              String             @id @default(cuid())
  tenantId        String
  tenantAppId     String
  planId          String
  status          SubscriptionStatus @default(trialing)
  priceSnapshot   Decimal            @db.Decimal(12, 2)
  currency        String             @default("CNY")
  billingPeriod   BillingPeriod
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean         @default(false)
  canceledAt      DateTime?
  trialEndsAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantApp   TenantApp        @relation(fields: [tenantAppId], references: [id])
  plan        Plan             @relation(fields: [planId], references: [id])
  changes     SubscriptionChange[]
  orders      BillingOrder[]
  entitlements Entitlement[]

  @@index([tenantId, status])
  @@index([tenantAppId])
}

model SubscriptionChange {
  id             String   @id @default(cuid())
  subscriptionId String
  fromPlanId     String?
  toPlanId       String?
  changeType     String
  effectiveAt    DateTime
  meta           Json?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model BillingOrder {
  id          String      @id @default(cuid())
  tenantId    String
  orderType   OrderType
  status      OrderStatus @default(pending)
  amountDue   Decimal     @db.Decimal(12, 2)
  amountPaid  Decimal     @db.Decimal(12, 2) @default(0)
  currency    String      @default("CNY")
  subscriptionId String?
  meta        Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  payments     Payment[]
  refunds      Refund[]

  @@index([tenantId, status])
}

model Payment {
  id            String        @id @default(cuid())
  billingOrderId String
  provider      String        @default("sandbox")
  providerRef   String?
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("CNY")
  status        PaymentStatus @default(pending)
  rawCallback   Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  billingOrder BillingOrder @relation(fields: [billingOrderId], references: [id], onDelete: Cascade)

  @@index([billingOrderId])
  @@index([providerRef])
}

model Refund {
  id             String       @id @default(cuid())
  billingOrderId String
  amount         Decimal      @db.Decimal(12, 2)
  status         RefundStatus @default(pending)
  reason         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  billingOrder BillingOrder @relation(fields: [billingOrderId], references: [id], onDelete: Cascade)

  @@index([billingOrderId])
}

// ─── Ledgers: Wallet / Points / Usage / Entitlement ────

model Wallet {
  id           String   @id @default(cuid())
  tenantId     String
  accountId    String?
  balanceCache Decimal  @default(0) @db.Decimal(14, 2)
  currency     String   @default("CNY")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ledgers WalletLedger[]

  @@unique([tenantId, accountId])
  @@index([tenantId])
}

model WalletLedger {
  id          String          @id @default(cuid())
  walletId    String
  direction   LedgerDirection
  amount      Decimal         @db.Decimal(14, 2)
  reason      String
  sourceType  String?
  sourceId    String?
  eventId     String?
  operatorId  String?
  createdAt   DateTime        @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, eventId])
  @@index([walletId, createdAt])
}

model PointsAccount {
  id           String   @id @default(cuid())
  tenantId     String
  membershipId String   @unique
  balanceCache Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  ledgers    PointsLedger[]
  lots       PointsLot[]

  @@index([tenantId])
}

model PointsLedger {
  id              String           @id @default(cuid())
  tenantId        String
  pointsAccountId String
  type            PointsLedgerType
  amount          Int
  reason          String
  operatorId      String?
  eventId         String?
  meta            Json?
  createdAt       DateTime         @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pointsAccount PointsAccount @relation(fields: [pointsAccountId], references: [id], onDelete: Cascade)
  redemption    Redemption?

  @@unique([tenantId, eventId])
  @@index([pointsAccountId, createdAt])
}

model PointsLot {
  id              String    @id @default(cuid())
  pointsAccountId String
  remaining       Int
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  pointsAccount PointsAccount @relation(fields: [pointsAccountId], references: [id], onDelete: Cascade)

  @@index([pointsAccountId, expiresAt])
}

model PointsRule {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  points    Int
  dailyCap  Int?
  active    Boolean  @default(true)
  meta      Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
}

model RewardCatalog {
  id           String     @id @default(cuid())
  tenantId     String
  sku          String
  name         String
  pointsPrice  Int
  stock        Int?
  type         RewardType
  fulfillEvent String?
  active       Boolean    @default(true)
  meta         Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  redemptions Redemption[]

  @@unique([tenantId, sku])
}

model Redemption {
  id             String        @id @default(cuid())
  tenantId       String
  rewardId       String
  pointsLedgerId String        @unique
  fulfillStatus  FulfillStatus @default(pending)
  shipping       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reward       RewardCatalog @relation(fields: [rewardId], references: [id])
  pointsLedger PointsLedger  @relation(fields: [pointsLedgerId], references: [id])

  @@index([tenantId, fulfillStatus])
}

model UsageAccount {
  id           String   @id @default(cuid())
  tenantId     String
  metricCode   String // ai.tokens | ai.requests | seats | storage_bytes
  balanceCache BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ledgers UsageLedger[]

  @@unique([tenantId, metricCode])
}

model UsageLedger {
  id             String          @id @default(cuid())
  usageAccountId String
  direction      LedgerDirection
  amount         BigInt
  reason         String
  eventId        String?
  createdAt      DateTime        @default(now())

  usageAccount UsageAccount @relation(fields: [usageAccountId], references: [id], onDelete: Cascade)

  @@unique([usageAccountId, eventId])
  @@index([usageAccountId, createdAt])
}

model UsageEvent {
  id            String   @id @default(cuid())
  tenantId      String
  tenantAppId   String?
  metricCode    String
  quantity      BigInt
  idempotencyKey String
  requestId     String?
  meta          Json?
  createdAt     DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantApp TenantApp? @relation(fields: [tenantAppId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, metricCode, createdAt])
}

model Entitlement {
  id             String    @id @default(cuid())
  tenantId       String
  subscriptionId String?
  code           String
  value          Json?
  startsAt       DateTime  @default(now())
  endsAt         DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId, code])
}

// ─── Affiliate (business order promo) ──────────────────

model AffiliatePartner {
  id             String        @id @default(cuid())
  tenantId       String
  membershipId   String        @unique
  inviteCode     String
  commissionRate Decimal       @default(0.3000) @db.Decimal(8, 4)
  payoutInfo     Json?
  status         PartnerStatus @default(pending)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership   Membership                   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  storefront   PartnerStorefront?
  attributions Attribution[]
  orderRefs    OrderRef[]
  commissions  AffiliateCommissionLedger[]
  settlements  AffiliateSettlement[]

  @@unique([tenantId, inviteCode])
  @@index([tenantId])
}

model PartnerStorefront {
  id        String   @id @default(cuid())
  tenantId  String
  partnerId String   @unique
  items     Json     @default("[]")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model Attribution {
  id         String   @id @default(cuid())
  tenantId   String
  visitorKey String
  partnerId  String
  touch      String   @default("last")
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([tenantId, visitorKey])
}

model OrderRef {
  id              String    @id @default(cuid())
  tenantId        String
  tenantAppId     String?
  externalOrderId String
  amountPaid      Decimal   @db.Decimal(12, 2)
  currency        String    @default("CNY")
  partnerId       String?
  accountId       String?
  paidAt          DateTime
  refundedAt      DateTime?
  meta            Json?
  createdAt       DateTime  @default(now())

  tenant      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantApp   TenantApp?                   @relation(fields: [tenantAppId], references: [id])
  partner     AffiliatePartner?            @relation(fields: [partnerId], references: [id])
  commissions AffiliateCommissionLedger[]

  @@unique([tenantId, externalOrderId])
  @@index([partnerId])
}

model AffiliateCommissionLedger {
  id           String           @id @default(cuid())
  tenantId     String
  orderRefId   String
  partnerId    String
  amount       Decimal          @db.Decimal(12, 2)
  rate         Decimal          @db.Decimal(8, 4)
  status       CommissionStatus @default(pending)
  holdUntil    DateTime?
  clawbackOfId String?
  statementId  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant     Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderRef   OrderRef                    @relation(fields: [orderRefId], references: [id])
  partner    AffiliatePartner            @relation(fields: [partnerId], references: [id])
  clawbackOf AffiliateCommissionLedger?  @relation("AffClawback", fields: [clawbackOfId], references: [id])
  clawbacks  AffiliateCommissionLedger[] @relation("AffClawback")
  statement  AffiliateSettlement?        @relation(fields: [statementId], references: [id])

  @@index([tenantId, status])
  @@index([partnerId, status])
}

model AffiliateSettlement {
  id           String                @id @default(cuid())
  tenantId     String
  partnerId    String?
  periodStart  DateTime
  periodEnd    DateTime
  totalAmount  Decimal               @db.Decimal(12, 2)
  reviewStatus StatementReviewStatus @default(draft)
  payoutProof  Json?
  reviewedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  tenant      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner     AffiliatePartner?            @relation(fields: [partnerId], references: [id])
  commissions AffiliateCommissionLedger[]

  @@index([tenantId, periodStart])
}

// ─── Channel Partner (SaaS sales) ──────────────────────

model ChannelPartner {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  status    PartnerStatus @default(pending)
  region    String?
  level     String        @default("L1")
  contract  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  memberships  ChannelMembership[]
  authorizations ChannelAuthorization[]
  leads        Lead[]
  referrals    TenantReferral[]
  policies     ChannelCommissionPolicy[]
  commissions  ChannelCommissionLedger[]
  settlements  ChannelSettlement[]
}

model ChannelMembership {
  id        String @id @default(cuid())
  channelId String
  accountId String
  roleCode  String @default("channel_sales")

  channel ChannelPartner @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, accountId])
}

model ChannelAuthorization {
  id            String @id @default(cuid())
  channelId     String
  applicationId String?
  planCode      String?
  region        String?

  channel ChannelPartner @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

model Lead {
  id          String   @id @default(cuid())
  channelId   String
  companyName String?
  contactEmail String?
  stage       String   @default("new")
  protectUntil DateTime?
  meta        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channel   ChannelPartner  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  referrals TenantReferral[]

  @@index([channelId, stage])
}

model TenantReferral {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  channelId String
  leadId    String?
  createdAt DateTime @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel ChannelPartner @relation(fields: [channelId], references: [id])
  lead    Lead?          @relation(fields: [leadId], references: [id])
}

model ChannelCommissionPolicy {
  id          String   @id @default(cuid())
  channelId   String
  version     Int      @default(1)
  newPurchaseRate Decimal @db.Decimal(8, 4)
  renewalRate Decimal  @db.Decimal(8, 4)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  channel ChannelPartner @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, version])
}

model ChannelCommissionLedger {
  id          String           @id @default(cuid())
  channelId   String
  tenantId    String?
  orderId     String?
  amount      Decimal          @db.Decimal(12, 2)
  rate        Decimal          @db.Decimal(8, 4)
  status      CommissionStatus @default(pending)
  statementId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  channel   ChannelPartner     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  statement ChannelSettlement? @relation(fields: [statementId], references: [id])

  @@index([channelId, status])
}

model ChannelSettlement {
  id           String                @id @default(cuid())
  channelId    String
  periodStart  DateTime
  periodEnd    DateTime
  totalAmount  Decimal               @db.Decimal(12, 2)
  reviewStatus StatementReviewStatus @default(draft)
  payoutProof  Json?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  channel     ChannelPartner             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  commissions ChannelCommissionLedger[]

  @@index([channelId, periodStart])
}

// ─── Platform ops ──────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  tenantId       String?
  actorAccountId String?
  action         String
  resource       String
  meta           Json?
  ip             String?
  requestId      String?
  createdAt      DateTime @default(now())

  tenant Tenant?  @relation(fields: [tenantId], references: [id])
  actor  Account? @relation(fields: [actorAccountId], references: [id])

  @@index([tenantId, createdAt])
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  tenantId    String
  scope       String
  key         String
  responseRef Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, key])
}

model OutboxEvent {
  id        String       @id @default(cuid())
  tenantId  String?
  eventType String
  payload   Json
  status    OutboxStatus @default(pending)
  attempts  Int          @default(0)
  nextRetry DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([status, nextRetry])
}

model InboxEvent {
  id             String   @id @default(cuid())
  tenantId       String
  eventType      String
  idempotencyKey String
  payload        Json
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, eventType])
}
