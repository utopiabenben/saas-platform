# Copy to ai-smart-english/.env.local (Vite) and integrations/ai-smart-english.env (secrets, gitignored)
# Frontend may only use VITE_* public values. CLIENT_SECRET must stay on a BFF in production.

PLATFORM_API_URL=http://localhost:3100/api/v1
PLATFORM_TENANT_ID=
PLATFORM_TENANT_SLUG=demo-a
PLATFORM_APPLICATION_KEY=ai-smart-english
PLATFORM_TENANT_APP_ID=
PLATFORM_CLIENT_ID=
PLATFORM_CLIENT_SECRET=
PLATFORM_WEBHOOK_SECRET=

# Demo login (seed)
DEMO_ADMIN_EMAIL=admin-a@example.com
DEMO_ADMIN_PASSWORD=ChangeMe123

# Vite public (safe to expose)
VITE_PLATFORM_API_URL=http://localhost:3100/api/v1
VITE_PLATFORM_TENANT_SLUG=demo-a
VITE_PLATFORM_TENANT_ID=
VITE_PLATFORM_APPLICATION_KEY=ai-smart-english
VITE_PLATFORM_TENANT_APP_ID=
